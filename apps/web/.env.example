# Copy to .env.local and adjust.

# Java API base URL used by server components
API_URL=http://localhost:8080

# Java API base URL used by the browser (analytics events)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Public URL of uploaded product images (must match the API setting)
MEDIA_PUBLIC_BASE_URL=http://localhost:8080/media

# Public address of the shop (used in sitemap.xml, canonical links and emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
